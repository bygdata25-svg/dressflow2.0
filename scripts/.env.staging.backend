# .env.staging.backend
# Copiar a backend/.env.staging o usarlo desde el script run_staging.sh

ENVIRONMENT=staging
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dressflow_staging
SECRET_KEY=staging-local-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcional si usás Cloudinary/local uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
