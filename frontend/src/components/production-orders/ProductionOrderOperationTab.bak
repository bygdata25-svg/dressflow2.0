                      {output.size ? <span>{tr(t, "production-orders:fields.size", "Talle")} {output.size}</span> : null}
                      {output.color ? <span>{output.color}</span> : null}
                    </div>

                    {output.notes ? (
                      <div className="po-op-output-card__notes">{output.notes}</div>
